<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="単語を登録"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="24dp" />

        <!-- デッキ名（表示のみ） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="デッキ"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EDE7F6">

            <TextView
                android:id="@+id/tvDeckName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#5C6BC0"
                tools:text="英単語 TOEIC"
                xmlns:tools="http://schemas.android.com/tools" />
        </androidx.cardview.widget.CardView>

        <!-- 単語・用語（必須） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="単語・用語"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTerm"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例）persuade"
                android:textSize="15sp"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 意味（正解）（必須） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="意味（正解）"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDefinition"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDefinition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例）説得する"
                android:textSize="15sp"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 例文（任意） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="例文（任意）"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <EditText
                android:id="@+id/etExample"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:padding="14dp"
                android:hint="She persuaded him to stay."
                android:textSize="14sp"
                android:background="@null"
                android:gravity="top"
                android:inputType="textMultiLine" />
        </androidx.cardview.widget.CardView>

        <!-- メモ（任意） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="メモ（任意）"
            android:textSize="13sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF">

            <EditText
                android:id="@+id/etMemo"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:padding="14dp"
                android:hint="ヒントや覚え方を入力..."
                android:textSize="14sp"
                android:background="@null"
                android:gravity="top"
                android:inputType="textMultiLine" />
        </androidx.cardview.widget.CardView>

        <!-- 保存ボタン -->
        <Button
            android:id="@+id/btnSaveWord"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="保存する"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7E57C2"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>